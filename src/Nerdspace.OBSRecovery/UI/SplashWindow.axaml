<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nerdspace.OBSRecovery.UI.SplashWindow"
        Title="NerdSpace Labs - Streamer Mission Control"
        Width="500" Height="240"
        CanResize="False"
        ShowInTaskbar="True"
        Icon="/Assets/app.ico"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="#000000">
  <Border Background="#0D0A14" BorderBrush="#241B3A" BorderThickness="1" CornerRadius="10" Padding="28">
    <Grid RowDefinitions="*,Auto">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" VerticalAlignment="Center">
        <Border Width="82" Height="82" CornerRadius="10" Background="#150F22" BorderBrush="#766595" BorderThickness="1">
          <Image Source="/Assets/app.png" Width="68" Height="68" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="NERDSPACE LABS" Classes="eyebrow"/>
          <TextBlock Text="STREAMER MISSION CONTROL" FontSize="25" FontWeight="Bold" Foreground="#F1EDFB"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="8" Margin="0,22,0,0">
        <TextBlock x:Name="LaunchStatusText" Text="Starting Streamer Mission Control" HorizontalAlignment="Center" Foreground="#948FB0" FontSize="12"/>
        <ProgressBar IsIndeterminate="True" Height="4"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
