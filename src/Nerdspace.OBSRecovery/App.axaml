<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nerdspace.OBSRecovery.App"
             Name="NerdSpace Labs - Streamer Mission Control"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/>
      <Setter Property="Background" Value="#000000"/>
      <Setter Property="Foreground" Value="#F1EDFB"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F1EDFB"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#948FB0"/>
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#A78BFA"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.6"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#0D0A14"/>
      <Setter Property="BorderBrush" Value="#241B3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="Border.subtleCard">
      <Setter Property="Background" Value="#150F22"/>
      <Setter Property="BorderBrush" Value="#241B3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Border.dangerCard">
      <Setter Property="Background" Value="#1B1316"/>
      <Setter Property="BorderBrush" Value="#5B2C33"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#150F22"/>
      <Setter Property="Foreground" Value="#F1EDFB"/>
      <Setter Property="BorderBrush" Value="#766595"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6D28D9"/>
      <Setter Property="Foreground" Value="#F1EDFB"/>
      <Setter Property="BorderBrush" Value="#8B5CF6"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#28191D"/>
      <Setter Property="Foreground" Value="#FCA5A5"/>
      <Setter Property="BorderBrush" Value="#7D3942"/>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#F1EDFB"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0D0A14"/>
      <Setter Property="Foreground" Value="#F1EDFB"/>
      <Setter Property="BorderBrush" Value="#766595"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#0D0A14"/>
      <Setter Property="Foreground" Value="#F1EDFB"/>
      <Setter Property="BorderBrush" Value="#766595"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#0D0A14"/>
      <Setter Property="BorderBrush" Value="#241B3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#948FB0"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#F1EDFB"/>
      <Setter Property="Background" Value="#150F22"/>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Foreground" Value="#8B5CF6"/>
      <Setter Property="Background" Value="#241B3A"/>
    </Style>

    <Style Selector="TextBlock.brandTitle">
      <Setter Property="Foreground" Value="#F1EDFB"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="0.4"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#8B5CF6"/>
      <Setter Property="BorderBrush" Value="#A78BFA"/>
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#5B21B6"/>
    </Style>
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/app.ico"
                ToolTipText="NerdSpace Labs - Streamer Mission Control"
                Clicked="TrayIcon_OnClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open Streamer Mission Control" Click="TrayOpen_OnClick" />
            <NativeMenuItem Header="Launch OBS" Click="TrayLaunch_OnClick" />
            <NativeMenuItem Header="Restart OBS" Click="TrayRestart_OnClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit Streamer Mission Control" Click="TrayExit_OnClick" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About NerdSpace Labs - Streamer Mission Control..." Click="About_OnClick" />
    </NativeMenu>
  </NativeMenu.Menu>
</Application>
